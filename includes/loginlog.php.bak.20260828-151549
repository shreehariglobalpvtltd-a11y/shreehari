<?php
/**
 * =====================================================================
 *  LoginLog — the record of who signed in, from where, and on what.
 *
 *  WHY THIS EXISTS
 *  ---------------
 *  Successful sign-ins already reached audit_logs through Logger::audit().
 *  Failed ones did not: Auth sent them to Logger::warning(), which writes
 *  app_logs. So the security view could show a sign-in but never the three
 *  failures immediately before it — which is the single pattern anyone
 *  actually looks for. Everything now lands in one place, successes and
 *  failures alike, with the IP, the browser and the device.
 *
 *  DEVICES
 *  -------
 *  A device is a long-lived random cookie. Only its SHA-256 is stored, so a
 *  leaked database row cannot be replayed as a device, and the cookie is
 *  httpOnly so page scripts cannot read it either. A device is "known" once
 *  it has completed a successful sign-in for that account; anything else is
 *  new, which is what makes "signed in from a new device" meaningful.
 *
 *  NOTHING HERE MAY BLOCK A SIGN-IN. Every public method swallows its own
 *  errors: if this table is missing because the migration has not been run,
 *  staff must still be able to work. Losing an audit row is bad; locking
 *  the whole company out of the admin panel is worse.
 * =====================================================================
 */

declare(strict_types=1);

if (!defined('SHG_APP')) {
    http_response_code(403);
    exit('Forbidden');
}

final class LoginLog
{
    /** Long-lived device cookie. Not a session, not a credential. */
    public const DEVICE_COOKIE = 'shg_dev';

    private const DEVICE_TTL_DAYS = 730;   // two years

    /**
     * This browser's device token, minting one if it has none.
     *
     * Returns '' when headers have already been sent and no cookie exists —
     * we simply do not track that request rather than emit a warning.
     */
    public static function deviceToken(): string
    {
        $raw = (string) ($_COOKIE[self::DEVICE_COOKIE] ?? '');

        // Must look like what we mint; anything else is discarded rather
        // than trusted, so a hand-crafted cookie cannot poison the table.
        if (preg_match('/^[a-f0-9]{64}$/', $raw) === 1) {
            return $raw;
        }

        if (headers_sent()) {
            return '';
        }

        try {
            $raw = bin2hex(random_bytes(32));
        } catch (Throwable $e) {
            return '';
        }

        $secure = (($_SERVER['HTTPS'] ?? '') !== '' && ($_SERVER['HTTPS'] ?? '') !== 'off')
            || (int) ($_SERVER['SERVER_PORT'] ?? 0) === 443;

        setcookie(self::DEVICE_COOKIE, $raw, [
            'expires'  => time() + (self::DEVICE_TTL_DAYS * 86400),
            'path'     => '/',
            'secure'   => $secure,
            'httponly' => true,
            'samesite' => 'Lax',
        ]);
        $_COOKIE[self::DEVICE_COOKIE] = $raw;

        return $raw;
    }

    /** The stored form of the device token. Never store the token itself. */
    public static function deviceHash(): string
    {
        $token = self::deviceToken();

        return $token === '' ? '' : hash('sha256', $token);
    }

    /**
     * A short human label for a user agent — "Chrome on Windows".
     *
     * Deliberately coarse. This is for a person scanning a device list, not
     * for analytics, and a precise parser would be a maintenance burden that
     * silently rots as browsers change their strings.
     */
    public static function deviceLabel(string $ua): string
    {
        if (trim($ua) === '') {
            return 'Unknown device';
        }

        $browser = 'Browser';
        foreach ([
            'Edg' => 'Edge', 'OPR' => 'Opera', 'Chrome' => 'Chrome',
            'Firefox' => 'Firefox', 'Safari' => 'Safari',
        ] as $needle => $name) {
            if (str_contains($ua, $needle)) { $browser = $name; break; }
        }

        $os = 'device';
        foreach ([
            'Android' => 'Android', 'iPhone' => 'iPhone', 'iPad' => 'iPad',
            'Windows' => 'Windows', 'Mac OS X' => 'Mac', 'Macintosh' => 'Mac',
            'Linux' => 'Linux',
        ] as $needle => $name) {
            if (str_contains($ua, $needle)) { $os = $name; break; }
        }

        return $browser . ' on ' . $os;
    }

    /**
     * Record one sign-in attempt.
     *
     * @param string $outcome one of the admin_login_events enum values
     * @return bool true when a SUCCESSFUL sign-in came from a browser this
     *              account has not used before (or one that was revoked)
     */
    public static function record(string $username, string $outcome, ?int $adminId = null): bool
    {
        $valid = ['success', 'bad_password', 'unknown_user', 'locked', 'disabled', 'logout'];
        if (!in_array($outcome, $valid, true)) {
            $outcome = 'bad_password';
        }

        try {
            $ua = substr((string) ($_SERVER['HTTP_USER_AGENT'] ?? ''), 0, 255);

            Database::insert('admin_login_events', [
                'admin_id'    => $adminId ?: null,
                'username'    => Security::clean($username, 60),
                'outcome'     => $outcome,
                'ip_address'  => Security::clientIp(),
                'user_agent'  => $ua !== '' ? $ua : null,
                'device_hash' => self::deviceHash() ?: null,
            ]);

            if ($outcome === 'success' && $adminId) {
                return self::touchDevice($adminId)['new'];
            }
        } catch (Throwable $e) {
            // Never block a sign-in over a logging failure — see the header.
            Logger::warning('LoginLog unavailable: ' . $e->getMessage(), [], 'security');
        }

        return false;
    }

    /**
     * Upsert this device against the account and say whether it was new.
     *
     * A REVOKED device counts as new again: revoking is how you say "I do
     * not recognise that browser", so it must not silently keep its history.
     *
     * @return array{new: bool, label: string}
     */
    public static function touchDevice(int $adminId): array
    {
        $hash  = self::deviceHash();
        $label = self::deviceLabel((string) ($_SERVER['HTTP_USER_AGENT'] ?? ''));

        if ($hash === '' || !Settings::getBool('device_tracking_enabled', true)) {
            return ['new' => false, 'label' => $label];
        }

        try {
            $row = Database::fetch(
                'SELECT id, revoked_at FROM admin_devices WHERE admin_id = :a AND device_hash = :h',
                ['a' => $adminId, 'h' => $hash]
            );

            $now = date('Y-m-d H:i:s');

            if ($row === null) {
                Database::insert('admin_devices', [
                    'admin_id'    => $adminId,
                    'device_hash' => $hash,
                    'label'       => $label,
                    'last_ip'     => Security::clientIp(),
                    'sign_ins'    => 1,
                    'last_seen'   => $now,
                ]);

                return ['new' => true, 'label' => $label];
            }

            $wasRevoked = !empty($row['revoked_at']);

            Database::query(
                'UPDATE admin_devices
                    SET sign_ins = sign_ins + 1, last_seen = :now, last_ip = :ip,
                        label = :lbl, revoked_at = NULL
                  WHERE id = :id',
                ['now' => $now, 'ip' => Security::clientIp(), 'lbl' => $label, 'id' => (int) $row['id']]
            );

            return ['new' => $wasRevoked, 'label' => $label];
        } catch (Throwable $e) {
            return ['new' => false, 'label' => $label];
        }
    }

    /**
     * Sign-in history, newest first. Pass an admin id to scope it to one
     * account, or 0 for the whole company.
     *
     * @return array<int, array<string, mixed>>
     */
    public static function history(int $adminId = 0, int $limit = 100, string $outcome = ''): array
    {
        $limit  = max(1, min(500, $limit));
        $where  = [];
        $params = [];

        if ($adminId > 0) {
            $where[]         = 'e.admin_id = :a';
            $params['a']     = $adminId;
        }
        if ($outcome !== '') {
            $where[]         = 'e.outcome = :o';
            $params['o']     = $outcome;
        }
        $sql = 'SELECT e.*, a.full_name, a.role
                  FROM admin_login_events e
                  LEFT JOIN admins a ON a.id = e.admin_id'
             . ($where !== [] ? ' WHERE ' . implode(' AND ', $where) : '')
             . ' ORDER BY e.id DESC LIMIT ' . $limit;

        try {
            return Database::fetchAll($sql, $params);
        } catch (Throwable $e) {
            return [];
        }
    }

    /**
     * Devices seen for an account, most recently used first.
     *
     * @return array<int, array<string, mixed>>
     */
    public static function devices(int $adminId): array
    {
        try {
            return Database::fetchAll(
                'SELECT * FROM admin_devices WHERE admin_id = :a
                  ORDER BY (revoked_at IS NULL) DESC, last_seen DESC',
                ['a' => $adminId]
            );
        } catch (Throwable $e) {
            return [];
        }
    }

    /** Is this the browser the request is coming from? */
    public static function isCurrentDevice(string $deviceHash): bool
    {
        $here = self::deviceHash();

        return $here !== '' && hash_equals($here, $deviceHash);
    }

    public static function revokeDevice(int $adminId, int $deviceId): void
    {
        Database::update(
            'admin_devices',
            ['revoked_at' => date('Y-m-d H:i:s')],
            'id = :id AND admin_id = :a',
            ['id' => $deviceId, 'a' => $adminId]
        );

        Logger::audit('admin.device.revoke', 'admin', (string) $adminId, null,
            ['device' => $deviceId], 'Device revoked');
    }

    /**
     * How many times this username has failed since a given point — the
     * "3 failures then a success" signal the old logging could not show.
     */
    public static function recentFailures(string $username, int $minutes = 60): int
    {
        try {
            return (int) Database::scalar(
                "SELECT COUNT(*) FROM admin_login_events
                  WHERE username = :u AND outcome <> 'success' AND outcome <> 'logout'
                    AND created_at >= DATE_SUB(NOW(), INTERVAL :m MINUTE)",
                ['u' => Security::clean($username, 60), 'm' => max(1, $minutes)],
                0
            );
        } catch (Throwable $e) {
            return 0;
        }
    }

    /** Drop history past the retention window. Called from the log rotation cron. */
    public static function prune(): int
    {
        $days = Settings::getInt('login_history_days', 180);
        if ($days <= 0) {
            return 0;
        }

        try {
            return Database::query(
                'DELETE FROM admin_login_events WHERE created_at < DATE_SUB(NOW(), INTERVAL :d DAY)',
                ['d' => $days]
            )->rowCount();
        } catch (Throwable $e) {
            return 0;
        }
    }
}
