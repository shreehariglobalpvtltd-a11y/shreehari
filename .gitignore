# --- Secrets & local-only files — never commit, never deploy ---
SHG-ADMIN-CREDENTIALS.txt
.deploy.env
config/config.local.php
# The real production config, with live database credentials and APP_KEY.
# Only config.sample.php is tracked: this file used to be tracked WITH
# placeholder credentials, so any deploy that included it would have
# overwritten the live database password and taken the site down.
config/config.php
.claude/

# The guards that keep the uploads tree private travel WITH the code, or a
# fresh install serves people's documents to anybody who guesses a URL until
# somebody remembers to edit nginx. The folders' contents stay untracked.
!uploads/.htaccess
!uploads/challan/.htaccess
!uploads/chalani/.htaccess
!uploads/passengers/.htaccess
!uploads/agents-kyc/.htaccess
!uploads/challan/index.html
!uploads/chalani/index.html
!uploads/passengers/index.html
!uploads/agents-kyc/index.html

# Generated PDFs / uploads — per-booking, never tracked
tickets/
invoice/
uploads/
qr/*.png

# Local dev / OS noise
*.log
*.lock
Thumbs.db
.DS_Store
node_modules/

# Runtime scratch — generated PDFs and working files, never tracked
tmp/
output/

# Editor / hot-fix backups — never tracked, never deployed (nginx already 404s *.bak)
*.bak
*.bak.*
