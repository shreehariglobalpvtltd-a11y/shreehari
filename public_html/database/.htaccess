# =====================================================================
#  SQL dumps must never be downloadable — they expose the full schema
#  and, in the case of backups, live customer data.
# =====================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
