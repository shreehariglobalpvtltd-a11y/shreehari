# =====================================================================
#  S Hari Global — public web root Apache config (Hostinger / cPanel)
# =====================================================================

# ---- Default document ------------------------------------------------
DirectoryIndex index.php index.html

# ---- Security headers (mirrors the PHP layer for static files) -------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), microphone=(self), camera=(self)"
  Header unset X-Powered-By
</IfModule>

# ---- Force HTTPS -----------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- Hide the raw application template; index.php serves it ----------
<Files "app.template.html">
  Require all denied
</Files>

# ---- Block dotfiles and backups --------------------------------------
<FilesMatch "(^\.|\.(bak|sql|log|ini|sample|dist|md)$)">
  Require all denied
</FilesMatch>

# ---- Never execute PHP inside the public uploads/ folder --------------
# (uploads/.htaccess already disables the engine there; this block is a
# defence-in-depth no-op for the rest of the site, which does need PHP.)

# ---- Long-cache static assets ----------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# ---- Service worker + PWA manifest: must never be long-cached --------
# (the 7-day JS Expires above would otherwise freeze SW updates; the SW
#  and manifest must be revalidated on every load so new versions ship.)
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </Files>
  <Files "manifest.webmanifest">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
<IfModule mod_expires.c>
  ExpiresByType application/manifest+json "access plus 0 seconds"
</IfModule>
# Serve .webmanifest with the correct MIME type.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# ---- Gzip text responses ---------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ---- Friendly error pages --------------------------------------------
ErrorDocument 404 /index.php
ErrorDocument 403 /index.php
